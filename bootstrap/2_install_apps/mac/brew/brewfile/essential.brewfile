# essential -- the apps needed right after the first setup
# Install only this file:  bash install.sh essential
# ~/github/prosseek/setup_mac/_readme.md
# The App Store apps themselves are installed by ../mas.

## Drive
brew "gdrive"
cask "google-drive"
#cask "synology-drive"
# cask "onedrive"

## Mac 
brew "mas"
brew "dockutil"
cask "devonthink"

## Lang
brew "python@3.14"
brew "uv"   # Extremely fast Python package installer and resolver, written in Rust

## UNIX
brew "rg"     # better grep
brew "zoxide" # z/zi -> fzf is needed
brew "fd"     # fdfind for Linx
brew "fzf"
brew "tree"   # Display directories as trees (with optional color/HTML output)
brew "ncurses"   # mini23
brew "htop"   # Improved top (interactive process viewer)
brew "direnv" # Load/unload environment variables based on $PWD
# We don't use symboliclinker -> .services generation and we don't use this feature
# cask "symboliclinker" # create symbolic link @ Finder right click
# brew uninstall --cask symboliclinker
