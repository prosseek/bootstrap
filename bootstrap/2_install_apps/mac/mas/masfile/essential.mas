# essential -- App Store apps needed right after the first setup
# Install only this file:  bash install.sh essential
#
# One app per line:  <App Store id>  <name>   (the name is only for reading)
# The App Store must be signed in first, or every line fails.
# ~/github/prosseek/setup/bootstrap/2_install_apps/mac/mas

# Example:
# mas list                  # installed App Store apps: id, name, version
# mas search MagicGlance    # search the App Store
# mas install 6449926189    # install by id (MagicGlance)

